# --- IPTV Scanner project ---
# Runtime database + WAL sidecars
data/
*.db
*.db-wal
*.db-shm

# Local playlist drops (often contain private stream URLs)
playlists/*.m3u
playlists/*.m3u8
!playlists/.gitkeep

# Channel icon cache (large binary assets)
# Legacy path (pre-static move) + current cache under static/
webroot/icons/*
!webroot/icons/.gitkeep
static/icons/*
!static/icons/.gitkeep

# Runtime JSON caches / manifests (regenerated by the app)
jsons/*.json
!jsons/.gitkeep

# Generated / scratch
*.tmp
_tmp_*.py
_check_*.py
.DS_Store
Thumbs.db
